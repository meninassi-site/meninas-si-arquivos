# Copy this file to .env and adjust as needed.

# Matches docker-compose.yml at the repo root (mysql service on host port 3307).
DATABASE_URL="mysql://meninas_si:meninas_si_dev_pw@localhost:3307/meninas_si"

# Used to sign admin session JWTs. Generate a real secret for anything beyond
# local development, e.g.: `openssl rand -hex 32`
JWT_SECRET="dev-only-secret-change-me"
JWT_EXPIRES_IN="8h"

PORT=3333

# Origin allowed to call the API with credentials (the Vite dev server by default).
CORS_ORIGIN="http://localhost:5173"
