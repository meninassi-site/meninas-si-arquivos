# Copy this file to .env and adjust as needed, then `docker compose up -d`.
# These values also appear in backend/.env.example as part of DATABASE_URL —
# keep the two in sync if you change them here.

MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Host port MySQL is published on. Not 3306, so this doesn't clash with any
# other MySQL container already running on the host.
MYSQL_PORT=3307

ADMINER_PORT=8081
